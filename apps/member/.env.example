# Copy to .env.local for local dev（正式環境在 Vercel > Settings > Environment Variables 設）
NEXT_PUBLIC_SUPABASE_URL=https://anfyoeviuhmzzrhilwtm.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<Dashboard > Project Settings > API > anon public>

# 可選：LIFF ID（LINE Developers > LIFF tab > Create app 拿到的 ID）
# 不填 → LIFF 自動登入功能關閉，只有 OAuth 按鈕
# 填 → 在 LINE app 內開啟時自動登入 + auto-register
NEXT_PUBLIC_LIFF_ID=

# 可選：租戶層預設 LINE 官方帳號的「基本 ID」（含 @，例 @123abcd）
# 用在現貨專區的「用 LINE 詢問店家」：
#   解析順序 = 該會員所在店的 stores.line_oa_basic_id → 這個 env → 都沒有就複製訊息
# 不填 → 功能仍可用，但 PWA 下只能把訊息複製到剪貼簿，不會直接開 LINE 對話
# 哪裡拿：LINE 官方帳號管理頁 > 設定 > 帳號設定 > 基本 ID
NEXT_PUBLIC_LINE_OA_ID=

NEXT_PUBLIC_BASE_PATH=

# 可選：本站對外的絕對網址（結尾不要斜線）
# 只用在 /join 推廣頁的 OG 分享卡：貼到 FB 社團 / LINE 群時，預覽圖必須是絕對網址，
# 爬蟲沒有「當前網域」的概念，相對路徑會抓不到圖。
# 不填 → 用線上會員站 https://new-erp-admin.vercel.app
NEXT_PUBLIC_SITE_URL=
