# Copy to .env.local and fill in values
# NEXT_PUBLIC_* vars are baked into the static export at build time.

NEXT_PUBLIC_SUPABASE_URL=https://anfyoeviuhmzzrhilwtm.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<from Supabase dashboard → Project Settings → API → anon/publishable key>

# Optional: URL prefix. Only needed when the site is NOT served from the domain root.
# Current deploy is a custom domain at the root (erp.www161616.com) -> leave this empty.
# Set it only for a sub-path deploy, e.g. /new_erp for <account>.github.io/new_erp/.
NEXT_PUBLIC_BASE_PATH=

# 對外絕對網址，給 /welcome/ 推廣頁的分享縮圖（og:image / og:url）用。末尾不要加斜線。
# 沒設時 welcome 頁會省略那幾個 tag，本機 build 不受影響；正式部署由
# .github/workflows/deploy-admin.yml 帶入，少了會讓 CI 直接失敗（不會安靜壞掉）。
NEXT_PUBLIC_SITE_URL=https://erp.www161616.com

# 會員端 shop 的對外網址，用於同步 FB 粉絲團時把 /shop/c/{id} 拼進貼文
# 末尾不要加斜線；未設定時預設 https://new-erp-admin.vercel.app
NEXT_PUBLIC_MEMBER_APP_URL=https://new-erp-admin.vercel.app
